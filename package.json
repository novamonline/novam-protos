{
  "name": "@novamonline/novam-protos",
  "version": "0.3.0",
  "description": "NOVAM contracts: the .proto files and their generated TypeScript (protobuf-es)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novamonline/novam-protos.git"
  },
  "files": [
    "proto/**/*.proto",
    "gen/ts"
  ],
  "exports": {
    "./novam/*": "./gen/ts/novam/*",
    "./proto/*": "./proto/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
